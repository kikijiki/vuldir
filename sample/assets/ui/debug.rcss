/* Vuldir scene inspector. The root fills the viewport for layout, while only
 * the panel participates in pointer hit-testing. */
body {
  width: 100%;
  height: 100%;
  margin: 0;
  font-family: LatoLatin;
  font-size: 13dp;
  color: #dce3eb;
  pointer-events: none;
}

.panel {
  display: block;
  position: absolute;
  top: 16dp;
  left: 16dp;
  width: 360dp;
  max-height: 90%;
  padding: 0 14dp 14dp 14dp;
  background-color: #10151df2;
  border: 1dp #303946;
  border-top: 3dp #e4aa4f;
  border-radius: 4dp;
  overflow-y: auto;
  pointer-events: auto;
  z-index: 10;
}

.panel-header {
  display: block;
  position: relative;
  width: 100%;
  height: 27dp;
  padding: 5dp 0;
  border-bottom: 1dp #2a323e;
  box-sizing: border-box;
  pointer-events: none;
  z-index: 2;
}

.panel-tabs {
  display: block;
  width: 100%;
}

.panel-tabs tabs {
  display: block;
  width: 100%;
  height: 27dp;
  padding-right: 27dp;
  border-bottom: 1dp #2a323e;
  box-sizing: border-box;
}

.panel-tabs tab {
  display: inline-block;
  height: 27dp;
  margin: 0 3dp 0 0;
  padding: 0 12dp;
  background-color: transparent;
  border-width: 0 0 2dp 0;
  border-color: transparent;
  border-radius: 0;
  color: #7f8da0;
  font-size: 9dp;
  letter-spacing: 1dp;
  line-height: 25dp;
}

.panel-tabs tab:hover {
  background-color: #202832;
  border-color: transparent;
  color: #d8dfe7;
}

.panel-tabs tab:selected {
  background-color: transparent;
  border-color: #e4aa4f;
  color: #f0f3f6;
}

.panel-tabs panels {
  display: block;
  width: 100%;
}

.panel.collapsed .panel-content {
  display: block;
}

.panel.collapsed .panel-tabs panels {
  display: none;
}

.panel-tabs panel {
  display: block;
  width: 100%;
}

.panel-content {
  display: block;
  width: 100%;
  margin-top: -27dp;
}

.tab-page {
  display: block;
  width: 100%;
}

.scene-tab {
  padding-top: 9dp;
}

.collapse-toggle {
  position: absolute;
  top: 2dp;
  right: 0;
  height: 22dp;
  width: 22dp;
  margin: 0;
  padding: 1dp 0 0 0;
  background-color: transparent;
  border: 0;
  color: #9eabb9;
  pointer-events: auto;
}

.collapse-toggle:hover {
  background-color: transparent;
  color: #f2c77f;
}

.collapse-arrow {
  display: block;
  width: 0;
  height: 0;
  margin: 6dp auto 0 auto;
}

.collapse-arrow.down {
  border-left: 5dp transparent;
  border-right: 5dp transparent;
  border-top: 7dp #9eabb9;
}

.collapse-arrow.right {
  margin-top: 5dp;
  border-top: 5dp transparent;
  border-bottom: 5dp transparent;
  border-left: 7dp #9eabb9;
}

.collapse-toggle:hover .collapse-arrow.down {
  border-top-color: #f2c77f;
}

.collapse-toggle:hover .collapse-arrow.right {
  border-left-color: #f2c77f;
}

.eyebrow {
  display: block;
  width: 100%;
  margin-bottom: 4dp;
  color: #e4aa4f;
  font-size: 10dp;
  letter-spacing: 2dp;
}

h1 {
  display: block;
  width: 100%;
  margin: 0;
  color: #f3f6f9;
  font-size: 20dp;
  font-weight: bold;
  line-height: 1.2;
}

.panel-header p {
  display: block;
  width: 100%;
  margin: 4dp 0 0 0;
  color: #7f8b9a;
  font-size: 12dp;
}

.section {
  display: block;
  width: auto;
  margin-top: 12dp;
  padding: 10dp 11dp 11dp 11dp;
  background-color: #181e28;
  border: 1dp #293240;
  border-radius: 3dp;
}

h2 {
  display: block;
  width: 100%;
  margin: 0 0 8dp 0;
  padding-bottom: 7dp;
  border-bottom: 1dp #2b3543;
  color: #e6ebf1;
  font-size: 13dp;
  font-weight: bold;
  line-height: 1.2;
}

.subhead,
.field-label {
  display: block;
  width: 100%;
  margin: 10dp 0 4dp 0;
  color: #697789;
  font-size: 9dp;
  letter-spacing: 1dp;
}

.row {
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 100%;
  height: 27dp;
  margin: 1dp 0;
}

.row label {
  width: 100dp;
  color: #aab4c0;
  font-size: 12dp;
}

.row input.range,
.row select {
  flex: 1;
  width: auto;
}

.slider-row label {
  width: 100dp;
}

.toggle-control {
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  width: 160dp;
}

.row select {
  flex: none;
  width: 160dp;
}

.slider-value {
  display: block;
  flex: none;
  width: 38dp;
  margin-left: 7dp;
  color: #d5dde6;
  font-size: 9dp;
  text-align: right;
}

.row .slider-reset {
  flex: none;
  width: 38dp;
  height: 19dp;
  margin: 0 0 0 6dp;
  padding: 0;
  background-color: transparent;
  border: 0;
  color: #728195;
  font-size: 7.5dp;
  letter-spacing: 0.5dp;
  text-align: right;
}

.row .slider-reset:hover {
  background-color: transparent;
  border-color: transparent;
  color: #e4aa4f;
}

input.range {
  height: 20dp;
}

input.range slidertrack {
  height: 4dp;
  margin-top: 8dp;
  margin-left: 3dp;
  margin-right: 3dp;
  background-color: #343e4c;
  border-radius: 2dp;
}

input.range sliderprogress {
  height: 4dp;
  background-color: #c88c35;
  border-radius: 2dp;
}

input.range sliderbar {
  width: 14dp;
  height: 14dp;
  margin-top: -5dp;
  margin-left: -7dp;
  margin-right: -7dp;
  background-color: #f1bc66;
  border: 2dp #181e28;
  border-radius: 9dp;
}

input.range:hover sliderbar,
input.range sliderbar:active {
  background-color: #fff1c9;
}

input.range sliderarrowdec,
input.range sliderarrowinc {
  display: none;
}

input.checkbox {
  width: 16dp;
  height: 16dp;
  background-color: #0d1117;
  border: 1dp #536072;
  border-radius: 3dp;
}

input.checkbox:hover {
  border-color: #e4aa4f;
}

input.checkbox:checked {
  background-color: #e4aa4f;
  border: 4dp #fff0c4;
}

input.text,
select {
  height: 25dp;
  padding: 3dp 7dp;
  background-color: #0d1117;
  border: 1dp #364253;
  border-radius: 2dp;
  color: #dce3eb;
  box-sizing: border-box;
}

input.text:focus,
select:focus {
  border-color: #e4aa4f;
}

select selectarrow {
  width: 0;
  height: 0;
  margin: 9dp 7dp 0 7dp;
  background-color: transparent;
  border-left: 4dp transparent;
  border-right: 4dp transparent;
  border-top: 6dp #8391a1;
}

select selectbox {
  margin-top: 2dp;
  background-color: #111720;
  border: 1dp #3b4758;
}

select selectbox option {
  padding: 5dp 8dp;
  color: #cbd3dd;
}

select selectbox option:hover,
select selectbox option:checked {
  background-color: #c88c35;
  color: #10151d;
}

.path {
  display: block;
  width: 100%;
  margin-bottom: 8dp;
}

.btnrow {
  display: flex;
  flex-direction: row;
  width: 100%;
}

.scene-tree {
  display: block;
  width: 100%;
  max-height: 70vh;
  background-color: #0d1219;
  border: 1dp #2d3744;
  overflow-y: auto;
}

.tree-empty {
  padding: 10dp;
  color: #667586;
  font-size: 10dp;
  text-align: center;
}

.tree-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  width: 100%;
  min-height: 30dp;
  padding: 5dp 6dp;
  border-bottom: 1dp #202936;
  box-sizing: border-box;
}

.tree-row:hover {
  background-color: #151d27;
}

.tree-indent {
  display: block;
  flex: none;
  height: 1dp;
}

.tree-indent.depth-one {
  width: 13dp;
}

.tree-indent.depth-two {
  width: 26dp;
}

.tree-marker {
  display: block;
  flex: none;
  width: 5dp;
  height: 5dp;
  margin: 6dp 8dp 0 3dp;
  background-color: #66778b;
}

.tree-marker.model {
  background-color: #e4aa4f;
}

.tree-marker.mesh {
  background-color: #66c4bb;
}

.tree-marker.primitive {
  background-color: #728298;
}

.tree-row.tree-model {
  background-color: #18212b;
}

.tree-copy {
  display: block;
  flex: 1;
  min-width: 0;
}

.tree-copy b,
.tree-copy small {
  display: block;
}

.tree-copy b {
  color: #cbd4dd;
  font-size: 10dp;
  font-weight: normal;
}

.tree-copy small {
  margin-top: 2dp;
  color: #667586;
  font-size: 8dp;
  line-height: 1.3;
}

button {
  height: 28dp;
  margin-right: 5dp;
  padding: 5dp 10dp;
  background-color: #252e3b;
  border: 1dp #465265;
  border-radius: 2dp;
  color: #dce3eb;
  font-size: 11dp;
}

button:hover {
  background-color: #344052;
  border-color: #66758a;
}

button:active {
  background-color: #1b222c;
}

button.primary {
  background-color: #c88c35;
  border-color: #e4aa4f;
  color: #10151d;
  font-weight: bold;
}

button.primary:hover {
  background-color: #e4aa4f;
}

.hint {
  display: block;
  width: 100%;
  margin: 12dp 2dp 0 2dp;
  color: #697789;
  font-size: 10dp;
  letter-spacing: 1dp;
}

.hint span {
  margin-left: 7dp;
  margin-right: 3dp;
  color: #b7c0cc;
}

.hint span:first-child {
  margin-left: 0;
}

scrollbarvertical {
  width: 8dp;
  margin: 4dp 2dp 4dp 0;
}

scrollbarvertical slidertrack {
  background-color: #0b0f15;
  border-radius: 4dp;
}

scrollbarvertical sliderbar {
  min-height: 32dp;
  margin: 1dp;
  background-color: #465365;
  border-radius: 3dp;
}

scrollbarvertical sliderbar:hover,
scrollbarvertical sliderbar:active {
  background-color: #e4aa4f;
}

scrollbarvertical sliderarrowdec,
scrollbarvertical sliderarrowinc {
  display: none;
}

.stats-panel {
  display: block;
  position: absolute;
  top: 16dp;
  right: 16dp;
  width: 272dp;
  padding: 13dp 14dp 14dp 14dp;
  background-color: #10151de8;
  border: 1dp #303946;
  border-top: 3dp #55b8aa;
  border-radius: 4dp;
  pointer-events: none;
  z-index: 9;
}

.stats-header {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  width: 100%;
  padding-bottom: 8dp;
  border-bottom: 1dp #2a323e;
}

.stats-header div {
  flex: 1;
}

.stats-header span,
.graph-label span,
.stat span,
.resource-stats span {
  color: #718092;
  font-size: 9dp;
  letter-spacing: 1dp;
}

.stats-header strong {
  margin-left: 8dp;
  color: #f3f6f9;
  font-size: 25dp;
}

.stats-header em {
  margin-left: 4dp;
  color: #55b8aa;
  font-size: 9dp;
  font-style: normal;
}

.stats-header b,
.graph-label b {
  color: #aeb9c5;
  font-size: 11dp;
  font-weight: normal;
}

.graph {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  width: 100%;
  height: 34dp;
  margin-top: 8dp;
  background-color: #0b1017;
  border-bottom: 1dp #344150;
}

.graph .graph-bar {
  display: block;
  flex: 1;
  width: 3dp;
  min-width: 1dp;
  margin-right: 1dp;
  background-color: #55b8aa;
}

.stats-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  width: 100%;
  margin-top: 10dp;
}

.stat {
  display: block;
  width: 50%;
  padding: 5dp 0;
}

.stat span,
.stat b {
  display: block;
}

.stat b {
  margin-top: 2dp;
  color: #e3e9ef;
  font-size: 13dp;
}

.graph-label {
  display: flex;
  flex-direction: row;
  width: 100%;
  margin-top: 7dp;
}

.graph-label span {
  flex: 1;
}

.cpu-graph {
  height: 32dp;
  margin-top: 4dp;
}

.cpu-graph i {
  background-color: #d69a43;
}

.resource-stats {
  display: block;
  width: 100%;
  margin-top: 10dp;
  padding-top: 8dp;
  border-top: 1dp #2a323e;
}

.resource-stats div {
  display: flex;
  flex-direction: row;
  width: 100%;
  min-height: 20dp;
}

.resource-stats div span {
  flex: 1;
}

.resource-stats div b {
  color: #cbd4dd;
  font-size: 10dp;
  font-weight: normal;
}

.resource-row {
  margin-top: 5dp;
  padding-top: 6dp;
  border-top: 1dp #222b36;
}

.resource-row span {
  color: #8896a6;
  font-size: 9dp;
  letter-spacing: 0dp;
}
